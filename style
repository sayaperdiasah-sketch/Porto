:root {
  --box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
  --income-color: #2ecc71;
  --expense-color: #e74c3c;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background-color: #f7f9fc;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
}

.container {
  width: 400px;
  background: #ffffff;
  padding: 30px;
  border-radius: 12px;
  box-shadow: var(--box-shadow);
}

h2 {
  text-align: center;
  margin-bottom: 20px;
  color: #333;
}

h3 {
  border-bottom: 1px solid #bbb;
  padding-bottom: 10px;
  margin: 40px 0 10px;
  color: #444;
}

/* Container Saldo & Ringkasan */
.balance-container {
  background: #2c3e50;
  color: #fff;
  padding: 20px;
  border-radius: 8px;
  text-align: center;
}

.inc-exp-container {
  background-color: #fff;
  color: #333;
  box-shadow: var(--box-shadow);
  padding: 15px;
  display: flex;
  justify-content: space-between;
  margin-top: 20px;
  border-radius: 6px;
}

.inc-exp-container > div {
  flex: 1;
  text-align: center;
}

.inc-exp-container > div:first-of-type {
  border-right: 1px solid #dedede;
}

.money {
  font-size: 18px;
  font-weight: bold;
  margin-top: 5px;
}

.money.plus { color: var(--income-color); }
.money.minus { color: var(--expense-color); }

/* List Transaksi */
.list {
  list-style-type: none;
  max-height: 200px;
  overflow-y: auto;
  margin-bottom: 40px;
}

.list li {
  background-color: #fff;
  color: #333;
  display: flex;
  justify-content: space-between;
  position: relative;
  padding: 12px;
  margin: 10px 0;
  border-radius: 6px;
  box-shadow: 0 2px 5px rgba(0,0,0,0.05);
}

.list li.plus { border-right: 5px solid var(--income-color); }
.list li.minus { border-right: 5px solid var(--expense-color); }

/* Form & Tombol */
label {
  display: inline-block;
  margin: 10px 0;
  font-weight: 600;
  color: #555;
}

input[type='text'], input[type='number'] {
  border: 1px solid #dedede;
  border-radius: 6px;
  display: block;
  font-size: 16px;
  padding: 12px;
  width: 100%;
  background: #fdfdfd;
}

.btn {
  cursor: pointer;
  background-color: #3498db;
  color: #fff;
  border: 0;
  display: block;
  font-size: 16px;
  font-weight: bold;
  margin: 20px 0 0;
  padding: 12px;
  width: 100%;
  border-radius: 6px;
  transition: background 0.3s ease;
}

.btn:hover { background-color: #2980b9; }
