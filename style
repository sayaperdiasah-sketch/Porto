:root{
  --bg: #05100c;
  --panel: #0a1c15;
  --panel-2: #0d2419;
  --grid: #12281f;
  --border: #1c3a2c;

  --hr-color: #39ff8a;
  --spo2-color: #4fd7ff;
  --audio-color: #ffd166;
  --alert: #ff5f56;
  --alert-glow: rgba(255, 95, 86, 0.35);

  --text: #dcece4;
  --text-dim: #7c9689;
  --text-faint: #4a6357;

  --font-mono: 'IBM Plex Mono', ui-monospace, monospace;
  --font-sans: 'IBM Plex Sans', system-ui, sans-serif;

  --radius: 6px;
}

*, *::before, *::after{ box-sizing: border-box; }

body{
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-sans);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

h1, h2{ margin: 0; font-family: var(--font-mono); font-weight: 600; }

/* ================= TOPBAR ================= */
.topbar{
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 18px clamp(16px, 4vw, 40px);
  border-bottom: 1px solid var(--border);
  background: var(--panel);
  flex-wrap: wrap;
}

.topbar h1{
  font-size: clamp(1rem, 2.2vw, 1.3rem);
  color: var(--text);
  text-align: center;
  flex: 1;
}

.device-id{ display: flex; align-items: center; gap: 10px; font-family: var(--font-mono); font-size: 13px; }

.dot{ width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }
.dot-live{ background: var(--hr-color); box-shadow: 0 0 8px var(--hr-color); animation: blink 1.6s infinite; }

@keyframes blink{
  0%, 100% { opacity: 1; }
  50% { opacity: 0.35; }
}

.sub{ display: block; font-size: 11px; color: var(--text-faint); margin-top: 2px; }

.battery{ text-align: right; font-family: var(--font-mono); font-size: 13px; }
.battery strong{ display: block; color: var(--hr-color); }

/* ================= MAIN ================= */
main{ max-width: 1100px; margin: 0 auto; padding: clamp(20px, 4vw, 40px); }

/* ================= BANNER ================= */
.banner{
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 20px 24px;
  margin-bottom: 24px;
  transition: border-color 0.3s ease, box-shadow 0.3s ease;
}

.banner.is-alert{
  border-color: var(--alert);
  box-shadow: 0 0 0 1px var(--alert-glow), 0 0 24px var(--alert-glow);
}

.banner-left{ display: flex; flex-direction: column; gap: 4px; }

.banner-label{
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--text-faint);
}

.banner-status{
  font-family: var(--font-mono);
  font-size: clamp(1.4rem, 3vw, 1.8rem);
  font-weight: 700;
  color: var(--hr-color);
  transition: color 0.3s ease;
}

.banner-status.alert{ color: var(--alert); }

.btn-trigger{
  font-family: var(--font-mono);
  font-size: 13px;
  color: var(--bg);
  background: var(--hr-color);
  border: none;
  border-radius: var(--radius);
  padding: 12px 20px;
  cursor: pointer;
  transition: transform 0.15s ease, filter 0.15s ease;
}
.btn-trigger:hover{ filter: brightness(1.1); transform: translateY(-1px); }
.btn-trigger:disabled{ opacity: 0.5; cursor: not-allowed; }

/* ================= LANES ================= */
.lanes{ display: grid; gap: 16px; margin-bottom: 32px; }

.lane{
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 16px 18px;
}

.lane-info{
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8px;
}

.lane-label{
  font-family: var(--font-mono);
  font-size: 12px;
  letter-spacing: 0.03em;
  color: var(--text-dim);
}

.lane-value{ display: flex; align-items: baseline; gap: 6px; font-family: var(--font-mono); }
.lane-value strong{ font-size: 22px; color: var(--text); }
.lane-value small{ font-size: 11px; color: var(--text-faint); }

.lane-canvas{
  width: 100%;
  height: 84px;
  display: block;
  border-radius: 4px;
  background: var(--panel-2);
}

/* ================= LOG ================= */
.log-section{
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 20px 24px;
}

.log-head{
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 16px;
  flex-wrap: wrap;
}

.log-head h2{ font-size: 15px; color: var(--text); }

.btn-secondary{
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--text);
  background: transparent;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 9px 16px;
  cursor: pointer;
  transition: border-color 0.2s ease, color 0.2s ease;
}
.btn-secondary:hover{ border-color: var(--hr-color); color: var(--hr-color); }

.table-wrap{ overflow-x: auto; }

table{ width: 100%; border-collapse: collapse; font-family: var(--font-mono); font-size: 13px; }

thead th{
  text-align: left;
  padding: 8px 10px;
  color: var(--text-faint);
  font-weight: 500;
  border-bottom: 1px solid var(--border);
  white-space: nowrap;
}

tbody td{
  padding: 9px 10px;
  border-bottom: 1px solid var(--grid);
  color: var(--text-dim);
  white-space: nowrap;
}

tbody tr:last-child td{ color: var(--text); }

.empty-state{
  font-family: var(--font-mono);
  font-size: 12.5px;
  color: var(--text-faint);
  padding: 18px 4px 4px;
  margin: 0;
}

/* ================= FOOTER ================= */
.footer{
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 clamp(16px, 4vw, 40px) 40px;
}
.footer p{
  font-size: 12px;
  color: var(--text-faint);
  border-top: 1px solid var(--border);
  padding-top: 16px;
}

@media (max-width: 640px){
  .topbar{ flex-direction: column; text-align: center; }
  .battery{ text-align: center; }
}

a:focus-visible, button:focus-visible{
  outline: 2px solid var(--hr-color);
  outline-offset: 2px;
}
