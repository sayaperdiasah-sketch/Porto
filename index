<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FinTrack - Manajer Keuangan Vanilla</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="container">
        <h2>💰 FinTrack</h2>
        
        <!-- Tampilan Saldo & Ringkasan -->
        <div class="balance-container">
            <h4>Saldo Anda</h4>
            <h1 id="balance">Rp 0</h1>
            <div class="inc-exp-container">
                <div class="income">
                    <h4>Pemasukan</h4>
                    <p id="money-plus" class="money plus">+Rp 0</p>
                </div>
                <div class="expense">
                    <h4>Pengeluaran</h4>
                    <p id="money-minus" class="money minus">-Rp 0</p>
                </div>
            </div>
        </div>

        <!-- Riwayat Transaksi -->
        <h3>📋 Riwayat Transaksi</h3>
        <ul id="list" class="list">
            <!-- Data dari JavaScript akan muncul di sini -->
        </ul>

        <!-- Form Tambah Transaksi -->
        <h3>➕ Tambah Transaksi Baru</h3>
        <form id="form">
            <div class="form-control">
                <label for="text">Keterangan</label>
                <input type="text" id="text" placeholder="Contoh: Gaji, Jajan, Kopi..." required />
            </div>
            <div class="form-control">
                <label for="amount">Jumlah (Gunakan tanda minus [-] untuk pengeluaran)</label>
                <input type="number" id="amount" placeholder="Contoh: 500000 atau -25000" required />
            </div>
            <button class="btn">Tambah Transaksi</button>
        </form>
    </div>

    <script src="script.js"></script>
</body>
</html>
